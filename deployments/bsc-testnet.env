# BSC testnet (chainId 97) deployment of 2026-10-12 -- see deployments/bsc-testnet.json.
# No timelock: the 2/3 Safe is admin on every contract (D-16 revised 2026-10-11).
# Public addresses only. No private keys or secrets belong in this file.
# Copy the values you need into your local .env (never commit .env).
CHAIN_ID=97
# The worker indexes with eth_getLogs; the bnbchain.org seed RPC rejects any block range
# ("limit exceeded"), so the worker needs an RPC that serves log ranges.
RPC_URL=https://bsc-testnet-rpc.publicnode.com
INDEXER_BATCH_SIZE=1000
ASSET_REGISTRY=0x80A01dD4CD334AD2B71823c5CF2B3d741A18b0AB
AUDIT_REGISTRY=0xc7d306902C16A8C84a1104312e121aC63903c1Ae
IDENTITY_REGISTRY=0xa9021298572b16DCD5465a025B3CdAEE90066FCF
SUBSCRIPTION_ROUTER=0x7DD7B1475F6A6CAb4d3B977B59a7aA8A5aB37416
# Flat-fee factory (2026-10-28, platform 30%); older factories stay in deployments/bsc-testnet.json as ProjectFactoryV1/V2.
PROJECT_FACTORY=0x7822f2Be8350082B574C552ca50fac7536F17985
PROJECT_ACTIVATOR=0xb9325DeC1692E94B03cF6d546a01FeA77cc3Adba
REFERRAL_REWARDS=0x966Cd32F336E7E5588956aeb472bdf8d289E8997
SHARE_MARKET=0xEf730dfd9f5Ab38B79d2E65Df34Bd4BfAf02DFCA
SAFE=0xf1f3a42F8F72432a22508B189Ffc52cA1bE33B3D
# TEST-ONLY MockUSDT (tUSDT, 18 decimals, anyone can mint)
PAYMENT_TOKEN=0x416b9b4fF2f862e3128B60996e7CD7c3cf87942B
START_BLOCK=136343141
CONFIRMATIONS=15
# Server wallets (public addresses; keys only in Railway). Settler has no role; autopilot wallets get
# OPERATOR_ROLE / REVIEWER_ROLE on AuditRegistry and each RevenueDistributor from the Safe.
SETTLER=0x43DAf13690424D0e40EDe889444f2987e7D751dE
AUTOPILOT_SUBMITTER=0xdAb257aE4F3E7c9584E60F202Bf137AcA8f90B56
BACKSTOP=0x0C2d2C338DCCf44f95ede95C1fBcaF7A52540Ed4
AUTOPILOT_APPROVER=0x4DDb888BEB3aE46f847E8E7C7C99e5Cc1Ef2190e

# Investor DApp (apps/web)
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Scan-to-connect (WalletConnect / Reown Cloud project ID; public). Unset hides the QR option.
