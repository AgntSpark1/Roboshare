# BSC testnet (chainId 97) unified redeployment of 2026-11-02 -- see deployments/bsc-testnet.json.
# No timelock: the 2/3 Safe is admin on every contract (D-16 revised 2026-10-11).
# Public addresses only. No private keys or secrets belong in this file.
# Copy the values you need into your local .env (never commit .env).
CHAIN_ID=97
# The worker indexes with eth_getLogs; the bnbchain.org seed RPC rejects any block range
# ("limit exceeded"), so the worker needs an RPC that serves log ranges.
RPC_URL=https://bsc-testnet-rpc.publicnode.com
INDEXER_BATCH_SIZE=1000
ASSET_REGISTRY=0x9485840fd14c63966f5060fcc2619ad62820e133
AUDIT_REGISTRY=0x9a613c5952b3b31fa83a7676fb292e599e0c6148
IDENTITY_REGISTRY=0xc9a962dd3f9ddf29c8aa195ae782f208cfbac607
SUBSCRIPTION_ROUTER=0xa9ad961298f0a521d1e3726df278515ba2ea4ca2
# 2026-11-02 unified redeploy (flat 30% fee tiers, launch, governance USDT emergency levers);
# the 2026-10-12 contracts and factories are retired (still listed in deployments/bsc-testnet.json history).
PROJECT_FACTORY=0xa90da43cc62307f1d0374509d671a371c9860474
PROJECT_ACTIVATOR=0x1eb87edac1ffa225030df72e3b7baceb27d91457
REFERRAL_REWARDS=0x1394a968ac75534266cc887ae4627aa8c38968f0
SHARE_MARKET=0x3c1c513f985bf10465f3c1015fb9fc1899a6338c
SAFE=0xf1f3a42F8F72432a22508B189Ffc52cA1bE33B3D
# TEST-ONLY MockUSDT (tUSDT, 18 decimals, anyone can mint) — reused from 2026-10-12 so
# existing tUSDT balances and approvals survive the redeploy.
PAYMENT_TOKEN=0x416b9b4fF2f862e3128B60996e7CD7c3cf87942B
START_BLOCK=140759396
CONFIRMATIONS=15
# Server wallets (public addresses; keys only on the server). Settler has no role; autopilot wallets get
# OPERATOR_ROLE / REVIEWER_ROLE on AuditRegistry and each RevenueDistributor from the Safe.
SETTLER=0x43DAf13690424D0e40EDe889444f2987e7D751dE
AUTOPILOT_SUBMITTER=0xdAb257aE4F3E7c9584E60F202Bf137AcA8f90B56
BACKSTOP=0x0C2d2C338DCCf44f95ede95C1fBcaF7A52540Ed4
AUTOPILOT_APPROVER=0x4DDb888BEB3bE46f847E8E7C7C99e5Cc1Ef2190e

# Investor DApp (apps/web)
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Scan-to-connect (WalletConnect / Reown Cloud project ID; public). Unset hides the QR option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=99f5247e2bc22f8fdffe97cf060e66b3
