# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/roboshare
REDIS_URL=redis://localhost:6379
# Chain: 97 = BSC testnet, 56 = BSC mainnet, 31337 = local anvil
CHAIN_ID=97
RPC_URL=
# Addresses come from the deployment output (script/Deploy.s.sol). Never placeholders.
ASSET_REGISTRY=
AUDIT_REGISTRY=
IDENTITY_REGISTRY=
SUBSCRIPTION_ROUTER=
PROJECT_FACTORY=
# ReferralRewards (optional until the referral programme is deployed; see docs/REFERRAL_DESIGN.md)
REFERRAL_REWARDS=
SHARE_MARKET=
START_BLOCK=
CONFIRMATIONS=15
# Session signing secret, at least 32 random bytes (openssl rand -hex 32)
SESSION_SECRET=
# Comma-separated: investor DApp and admin console hosts.
SIWE_DOMAIN=localhost:3000,localhost:3001
# 32-byte hex key that encrypts staff TOTP secrets (required in production)
TOTP_ENC_KEY=
RATE_LIMIT_PER_MINUTE=120
# The 2/3 governance Safe; it is admin on every contract (no timelock). Governance prepares are Safe transactions.
SAFE=
# BSC mainnet RPC for read-only Aave market data (optional)
AAVE_RPC_URL=
# Worker: gas-only wallet with NO contract role that auto-settles sold-out offerings (optional; keep a little BNB on it)
SETTLER_PRIVATE_KEY=
PAYMENT_TOKEN=
# Worker: monthly profit distribution autopilot (optional). Two DIFFERENT keys; the Safe grants the submitter
# OPERATOR_ROLE and the approver REVIEWER_ROLE on AuditRegistry and each RevenueDistributor (admin console > 自动分配).
# They cannot change parameters or roles, or send funds anywhere but to holders pro rata. Keep a little BNB on each.
AUTOPILOT_SUBMITTER_KEY=
AUTOPILOT_APPROVER_KEY=
# Largest monthly batch sent without a person, in whole USDT; above it staff propose the batch in the console.
AUTOPILOT_MAX_BATCH_USDT=100000
# API: the same two wallets' public addresses, for the console's 自动分配 page.
AUTOPILOT_SUBMITTER=
AUTOPILOT_APPROVER=
# Scan-to-connect (WalletConnect / Reown Cloud project ID; public). Unset hides the QR option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
