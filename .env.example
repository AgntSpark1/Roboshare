# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/roboshare
REDIS_URL=redis://localhost:6379
# Chain: 97 = BSC testnet, 56 = BSC mainnet, 31337 = local anvil
CHAIN_ID=97
RPC_URL=
# Addresses come from the deployment output (script/Deploy.s.sol). Never placeholders.
ASSET_REGISTRY=
AUDIT_REGISTRY=
IDENTITY_REGISTRY=
SUBSCRIPTION_ROUTER=
PROJECT_FACTORY=
# ReferralRewards (optional until the referral programme is deployed; see docs/REFERRAL_DESIGN.md)
REFERRAL_REWARDS=
SHARE_MARKET=
START_BLOCK=
CONFIRMATIONS=15
# Session signing secret, at least 32 random bytes (openssl rand -hex 32)
SESSION_SECRET=
# Comma-separated: investor DApp and admin console hosts.
SIWE_DOMAIN=localhost:3000,localhost:3001
# HMAC secret shared with the KYC provider webhook
KYC_WEBHOOK_SECRET=
# 32-byte hex key that encrypts staff TOTP secrets (required in production)
TOTP_ENC_KEY=
RATE_LIMIT_PER_MINUTE=120
# TimelockController from the deployment output; governance prepares wrap calls in schedule/execute
TIMELOCK=
TIMELOCK_DELAY_SECONDS=86400
# BSC mainnet RPC for read-only Aave market data (optional)
AAVE_RPC_URL=
PAYMENT_TOKEN=
