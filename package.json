{
  "name": "roboshare",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "abi": "pnpm --filter @roboshare/shared abi",
    "db:generate": "pnpm --filter @roboshare/db generate",
    "db:migrate": "pnpm --filter @roboshare/db migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "postcss": "8.5.23",
      "ws@>=8.0.0 <8.21.0": "8.22.0",
      "@walletconnect/logger>pino": "10.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vcc3-ghjq-m6fr"
      ]
    }
  }
}
