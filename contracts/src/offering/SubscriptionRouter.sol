pragma solidity 0.8.30;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {IAssetRegistry, IOfferingManager, ISubscriptionRouter} from "../interfaces/IRoboShare.sol";

/// @title SubscriptionRouter
/// @notice Single entry point investors approve USDT to once (D-23). Each call pulls exactly
/// `quote(units)` from the caller and sends it straight to the project's linked OfferingManager.
/// The router never pulls from anyone but `msg.sender`, never holds funds, and has no withdrawal
/// or admin transfer function. Governance can only pause/unpause and set the referral terms.
///
/// Referrals (REFERRAL_DESIGN.md): single tier only. `subscribeWithReferrer` records who referred an
/// investor on that investor's first subscription through this router; the money flow is identical
/// to `subscribe`. Binding is off until governance enables it, and the terms in force at bind time
/// (share of the platform fee, window) are emitted with the binding so later changes only affect new
/// bindings. Rewards are paid from platform fees by `ReferralRewards`, never from investor funds.
contract SubscriptionRouter is ISubscriptionRouter, AccessControl, Pausable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");

    IERC20 private immutable _usdt;
    IAssetRegistry public immutable assetRegistry;

    uint16 public constant MAX_REFERRAL_SHARE_BPS = 5_000;
    uint64 public constant MAX_REFERRAL_WINDOW = 3_650 days;

    bool public referralsEnabled;
    /// @notice Share of the platform fee generated by a referred investor that goes to the referrer.
    uint16 public referralShareBps = 2_000;
    /// @notice How long after binding the referrer earns that share.
    uint64 public referralWindow = 365 days;

    mapping(address investor => bool) public hasSubscribed;
    mapping(address investor => address) public referrerOf;

    event RoutedSubscription(
        bytes32 indexed projectId, address indexed investor, address indexed offering, uint32 units, uint256 cost
    );

    event ReferralBound(address indexed investor, address indexed referrer, uint16 shareBps, uint64 expiresAt);
    event ReferralTermsSet(bool enabled, uint16 shareBps, uint64 window);

    error ZeroValue();
    error InvalidReferralTerms();
    error OfferingNotLinked(bytes32 projectId);
    error CostAboveMax(uint256 cost, uint256 maxCost);

    constructor(IERC20 usdt_, IAssetRegistry assetRegistry_, address admin, address pauser) {
        if (address(usdt_) == address(0) || address(assetRegistry_) == address(0) || admin == address(0)) {
            revert ZeroValue();
        }
        _usdt = usdt_;
        assetRegistry = assetRegistry_;
        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        if (pauser != address(0)) _grantRole(PAUSER_ROLE, pauser);
    }

    function USDT() external view returns (address) {
        return address(_usdt);
    }

    /// @param maxCost Upper bound the investor accepts; protects against a wrong project or price.
    function subscribe(bytes32 projectId, uint32 units, uint256 maxCost) external nonReentrant whenNotPaused {
        _subscribe(projectId, units, maxCost);
    }

    /// @notice Same as `subscribe`, and on the caller's first subscription records `referrer`.
    /// @dev An unusable referrer (referrals off, zero, self, or a wallet that never subscribed) is
    /// ignored rather than reverting, so a bad invite link never blocks a purchase.
    function subscribeWithReferrer(bytes32 projectId, uint32 units, uint256 maxCost, address referrer)
        external
        nonReentrant
        whenNotPaused
    {
        bool first = !hasSubscribed[msg.sender];
        _subscribe(projectId, units, maxCost);
        if (first && referralsEnabled && referrer != address(0) && referrer != msg.sender && hasSubscribed[referrer]) {
            referrerOf[msg.sender] = referrer;
            emit ReferralBound(msg.sender, referrer, referralShareBps, uint64(block.timestamp) + referralWindow);
        }
    }

    /// @notice Governance (timelock) only. New terms apply to bindings made afterwards.
    function setReferralTerms(bool enabled, uint16 shareBps, uint64 window) external onlyRole(DEFAULT_ADMIN_ROLE) {
        if (shareBps > MAX_REFERRAL_SHARE_BPS || window == 0 || window > MAX_REFERRAL_WINDOW) {
            revert InvalidReferralTerms();
        }
        referralsEnabled = enabled;
        referralShareBps = shareBps;
        referralWindow = window;
        emit ReferralTermsSet(enabled, shareBps, window);
    }

    function _subscribe(bytes32 projectId, uint32 units, uint256 maxCost) private {
        if (units == 0) revert ZeroValue();
        address offering = assetRegistry.offeringOf(projectId);
        if (offering == address(0)) revert OfferingNotLinked(projectId);

        uint256 cost = IOfferingManager(offering).quote(units);
        if (cost == 0) revert ZeroValue();
        if (cost > maxCost) revert CostAboveMax(cost, maxCost);

        hasSubscribed[msg.sender] = true;
        _usdt.safeTransferFrom(msg.sender, offering, cost);
        IOfferingManager(offering).subscribeFor(msg.sender, units, cost);
        emit RoutedSubscription(projectId, msg.sender, offering, units, cost);
    }

    function pause() external onlyRole(PAUSER_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(DEFAULT_ADMIN_ROLE) {
        _unpause();
    }
}
