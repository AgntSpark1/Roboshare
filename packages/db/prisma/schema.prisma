// Authoritative database schema (DATABASE_SCHEMA.md is the design note).
// Amounts are token base units in numeric(78,0). Addresses are stored lowercase.
// Rows derived from chain events can always be rebuilt from chain.event.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "chain", "compliance"]
}

// ---------------------------------------------------------------- chain

model ChainBlock {
  chainId    Int
  number     BigInt
  hash       String
  timestamp  DateTime

  @@id([chainId, number])
  @@map("block")
  @@schema("chain")
}

model ChainEvent {
  id          String   @id @default(uuid()) @db.Uuid
  chainId     Int
  blockNumber BigInt
  blockHash   String
  txHash      String
  logIndex    Int
  address     String
  name        String
  args        Json
  createdAt   DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, blockNumber, logIndex])
  @@map("event")
  @@schema("chain")
}

model IndexerCursor {
  chainId   Int      @id
  lastBlock BigInt
  lastHash  String
  updatedAt DateTime @updatedAt

  @@map("indexer_cursor")
  @@schema("chain")
}

model ContractDeployment {
  chainId       Int
  address       String
  kind          String
  projectId     String?
  deployedBlock BigInt
  createdAt     DateTime @default(now())

  @@id([chainId, address])
  @@map("contract_deployment")
  @@schema("chain")
}

model RoleGrant {
  chainId  Int
  contract String
  role     String
  account  String
  active   Boolean
  eventId  String  @db.Uuid

  @@id([chainId, contract, role, account])
  @@index([account])
  @@map("contract_role_grant")
  @@schema("chain")
}

model ReconciliationRun {
  id     String                @id @default(uuid()) @db.Uuid
  runAt  DateTime              @default(now())
  block  BigInt
  ok     Boolean
  issues ReconciliationIssue[]

  @@map("reconciliation_run")
  @@schema("chain")
}

model ReconciliationIssue {
  id         String            @id @default(uuid()) @db.Uuid
  runId      String            @db.Uuid
  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  scope      String
  subject    String
  expected   String
  actual     String
  severity   String
  resolvedAt DateTime?

  @@map("reconciliation_issue")
  @@schema("chain")
}

// ---------------------------------------------------------------- app: projects

enum ProjectState {
  NONE
  DRAFT
  VERIFIED
  OFFERING
  FUNDED
  ACTIVE
  SUSPENDED
  EXIT_PENDING
  TERMINATED
  CLOSED
  CANCELLED

  @@schema("app")
}

model Project {
  projectIdOnchain   String       @id
  assetIdOnchain     String       @unique
  issuerId           String
  rightsDocHash      String
  registrant         String
  state              ProjectState
  tokenAddress       String?
  offeringAddress    String?
  distributorAddress String?
  fundedAtBlock      BigInt?
  registeredBlock    BigInt
  /// Operating term in days (OPERATING_TERM_PROPOSAL.md); set before the offering opens, default 720.
  termDays           Int?
  /// Block time of the first FUNDED -> ACTIVE transition; the term ends termDays later.
  operatingStartedAt DateTime?

  stateChanges ProjectStateChange[]
  offering     Offering?
  holdings     Holding[]
  batches      DistributionBatch[]

  @@map("project")
  @@schema("app")
}

/// Off-chain presentation metadata, edited by operators. Never derived from chain, so it has no
/// foreign key to the chain-derived project table (which is rebuilt after a reorg).
model ProjectMeta {
  projectIdOnchain String   @id
  slug             String   @unique
  title            String
  make             String?
  model            String?
  modelYear        Int?
  summary          String?
  updatedAt        DateTime @updatedAt

  @@map("project_meta")
  @@schema("app")
}

model ProjectStateChange {
  id               String       @id @default(uuid()) @db.Uuid
  projectIdOnchain String
  project          Project      @relation(fields: [projectIdOnchain], references: [projectIdOnchain], onDelete: Cascade)
  fromState        ProjectState
  toState          ProjectState
  reasonHash       String
  actor            String
  blockNumber      BigInt
  txHash           String
  eventId          String       @unique @db.Uuid

  @@map("project_state_change")
  @@schema("app")
}

enum OfferingStatus {
  CONFIGURED
  OPEN
  SETTLED
  FAILED
  CANCELLED

  @@schema("app")
}

model Offering {
  projectIdOnchain String         @id
  project          Project        @relation(fields: [projectIdOnchain], references: [projectIdOnchain], onDelete: Cascade)
  address          String         @unique
  status           OfferingStatus
  unitPrice        Decimal        @db.Decimal(78, 0)
  minUnits         Int
  maxUnits         Int
  perWalletMax     Int
  startAt          DateTime
  endAt            DateTime
  treasury         String
  termsHash        String
  unitsSold        Int            @default(0)
  proceeds         Decimal?       @db.Decimal(78, 0)
  subscriptions    Subscription[]

  @@map("offering")
  @@schema("app")
}

enum SubscriptionStatus {
  ESCROWED
  SETTLED
  REFUNDABLE
  REFUNDED

  @@schema("app")
}

model Subscription {
  projectIdOnchain String
  offering         Offering           @relation(fields: [projectIdOnchain], references: [projectIdOnchain], onDelete: Cascade)
  wallet           String
  units            Int
  amount           Decimal            @db.Decimal(78, 0)
  status           SubscriptionStatus
  lastTxHash       String

  @@id([projectIdOnchain, wallet])
  @@index([wallet])
  @@map("subscription")
  @@schema("app")
}

model TokenTransfer {
  id               String @id @default(uuid()) @db.Uuid
  projectIdOnchain String
  fromAddress      String
  toAddress        String
  units            Int
  kind             String
  blockNumber      BigInt
  logIndex         Int
  txHash           String
  eventId          String @unique @db.Uuid

  @@index([projectIdOnchain, blockNumber])
  @@index([toAddress])
  @@index([fromAddress])
  @@map("token_transfer")
  @@schema("app")
}

model Holding {
  projectIdOnchain String
  project          Project @relation(fields: [projectIdOnchain], references: [projectIdOnchain], onDelete: Cascade)
  wallet           String
  units            Int
  lastBlock        BigInt

  @@id([projectIdOnchain, wallet])
  @@index([wallet])
  @@map("holding")
  @@schema("app")
}

enum EligibilityState {
  NONE
  ELIGIBLE
  FROZEN

  @@schema("app")
}

/// Current on-chain eligibility per wallet (codes only; no personal data).
model Eligibility {
  wallet         String           @id
  status         EligibilityState
  investorClass  Int?
  jurisdiction   Int?
  expiresAt      DateTime?
  attestationRef String?
  lastBlock      BigInt

  @@map("eligibility")
  @@schema("app")
}

// ---------------------------------------------------------------- app: reports and distributions

model AuditRecord {
  recordIdOnchain     String  @id
  projectIdOnchain    String
  kind                String
  status              String
  contentHash         String
  docType             String
  version             Int
  supersedes          String?
  supersededBy        String?
  periodStart         BigInt
  periodEnd           BigInt
  distributableAmount Decimal @db.Decimal(78, 0)
  paymentToken        String
  submitter           String
  reviewer            String?
  submittedBlock      BigInt

  @@index([projectIdOnchain])
  @@map("audit_record")
  @@schema("app")
}

enum ReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED

  @@schema("app")
}

model FinancialReport {
  id                  String         @id @default(uuid()) @db.Uuid
  projectIdOnchain    String
  periodStart         DateTime       @db.Date
  periodEnd           DateTime       @db.Date
  paymentToken        String
  grossRevenue        Decimal        @db.Decimal(78, 0)
  totalExpenses       Decimal        @db.Decimal(78, 0)
  totalReserves       Decimal        @db.Decimal(78, 0)
  distributableAmount Decimal        @db.Decimal(78, 0)
  canonicalHash       String         @unique
  body                Json
  status              ReportStatus   @default(SUBMITTED)
  supersedesId        String?        @db.Uuid
  submittedByUserId   String         @db.Uuid
  submittedByWallet   String
  submittedAt         DateTime       @default(now())
  recordIdOnchain     String?        @unique
  lines               ReportLine[]
  reviews             ReportReview[]

  @@index([projectIdOnchain, periodStart, periodEnd])
  @@map("financial_report")
  @@schema("app")
}

enum ReportSection {
  REVENUE
  EXPENSE
  RESERVE

  @@schema("app")
}

model ReportLine {
  id          String          @id @default(uuid()) @db.Uuid
  reportId    String          @db.Uuid
  report      FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  section     ReportSection
  category    String
  description String
  amount      Decimal         @db.Decimal(78, 0)

  @@map("report_line")
  @@schema("app")
}

model ReportReview {
  id             String          @id @default(uuid()) @db.Uuid
  reportId       String          @db.Uuid
  report         FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewerUserId String          @db.Uuid
  decision       String
  reason         String?
  decidedAt      DateTime        @default(now())

  @@map("report_review")
  @@schema("app")
}

enum BatchStatus {
  PROPOSED
  CLAIMABLE
  REJECTED

  @@schema("app")
}

model DistributionBatch {
  projectIdOnchain String
  project          Project                  @relation(fields: [projectIdOnchain], references: [projectIdOnchain], onDelete: Cascade)
  batchIdOnchain   Int
  reportId         String
  amount           Decimal                  @db.Decimal(78, 0)
  pool             Decimal                  @db.Decimal(78, 0)
  totalNet         Decimal                  @db.Decimal(78, 0)
  totalFee         Decimal                  @db.Decimal(78, 0)
  dustOut          Decimal                  @db.Decimal(78, 0)
  snapshotBlock    BigInt
  status           BatchStatus
  proposeTxHash    String
  approveTxHash    String?
  approver         String?
  /// Fee-free return of capital (vehicle sale proceeds, reserve, insurance) at term end.
  capitalReturn    Boolean                  @default(false)
  allocations      DistributionAllocation[]

  @@id([projectIdOnchain, batchIdOnchain])
  @@map("distribution_batch")
  @@schema("app")
}

model DistributionAllocation {
  projectIdOnchain String
  batchIdOnchain   Int
  batch            DistributionBatch @relation(fields: [projectIdOnchain, batchIdOnchain], references: [projectIdOnchain, batchIdOnchain], onDelete: Cascade)
  wallet           String
  units            Int
  gross            Decimal           @db.Decimal(78, 0)
  feeBps           Int
  net              Decimal           @db.Decimal(78, 0)
  claimed          Boolean           @default(false)
  claimTxHash      String?

  @@id([projectIdOnchain, batchIdOnchain, wallet])
  @@index([wallet])
  @@map("distribution_allocation")
  @@schema("app")
}

// ---------------------------------------------------------------- app: referrals (REFERRAL_DESIGN.md)

/// Projection of SubscriptionRouter.ReferralBound: one referrer per referee, forever. The referrer's own
/// referrer is the second level (REFERRAL_DESIGN.md §8).
model Referral {
  referee     String   @id
  referrer    String
  /// Terms in force when the binding was made; later governance changes do not touch them.
  shareBps    Int
  expiresAt   DateTime
  boundBlock  BigInt
  boundTxHash String

  @@index([referrer])
  @@map("referral")
  @@schema("app")
}

/// A referrer's cut of the platform fee on one referee allocation, accrued when the batch is approved.
/// level 1: the referee's own referrer; level 2: that referrer's referrer.
model ReferralAccrual {
  projectIdOnchain String
  batchIdOnchain   Int
  referee          String
  level            Int     @default(1)
  referrer         String
  fee              Decimal @db.Decimal(78, 0)
  shareBps         Int
  reward           Decimal @db.Decimal(78, 0)

  @@id([projectIdOnchain, batchIdOnchain, referee, level])
  @@index([referrer])
  @@map("referral_accrual")
  @@schema("app")
}

/// Projection of ReferralRewards.ReferralRootSet.
model ReferralRoot {
  epoch           Int     @id
  root            String
  dataHash        String
  totalCumulative Decimal @db.Decimal(78, 0)
  blockNumber     BigInt
  txHash          String

  @@map("referral_root")
  @@schema("app")
}

/// Projection of ReferralRewards.ReferralRewardClaimed: cumulative amount paid per account.
model ReferralClaim {
  account    String  @id
  claimed    Decimal @db.Decimal(78, 0)
  lastTxHash String

  @@map("referral_claim")
  @@schema("app")
}

/// Merkle tree prepared by staff (off-chain, survives projection rebuilds). Served as proofs once
/// its root is published on chain.
model ReferralTree {
  root            String   @id
  dataHash        String
  totalCumulative Decimal  @db.Decimal(78, 0)
  /// [{ account, cumulative, proof }]
  entries         Json
  createdAt       DateTime @default(now())
  createdByUserId String   @db.Uuid

  @@map("referral_tree")
  @@schema("app")
}

// ---------------------------------------------------------------- app: users and admin

model User {
  id        String        @id @default(uuid()) @db.Uuid
  createdAt DateTime      @default(now())
  wallets   Wallet[]
  staff     StaffAccount?

  @@map("user")
  @@schema("app")
}

model Wallet {
  address  String   @id
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAt DateTime @default(now())

  @@map("wallet")
  @@schema("app")
}

/// Off-chain staff record. Admin routes also require the matching on-chain role (RoleGrant).
model StaffAccount {
  userId        String    @id @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles         String[]
  disabledAt    DateTime?
  /// TOTP secret encrypted with AES-256-GCM (TOTP_ENC_KEY); base32 secret never stored in clear.
  totpSecretEnc String?

  @@map("staff_account")
  @@schema("app")
}

model RiskAcknowledgement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  wallet     String
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, version])
  @@map("risk_acknowledgement")
  @@schema("app")
}

/// Transactions a wallet submitted from the UI, tracked until the indexer sees them.
model PendingTx {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  chainId   Int
  hash      String
  purpose   String
  createdAt DateTime @default(now())

  @@unique([chainId, hash])
  @@index([userId])
  @@map("pending_tx")
  @@schema("app")
}

/// A governance Safe transaction waiting for owner confirmations. Owners confirm on-chain (approveHash) and the
/// last one executes from the console; the Safe nonce is fixed at the first confirmation so the hash stays stable.
model SafeTx {
  id          String    @id @default(uuid()) @db.Uuid
  chainId     Int
  safe        String
  to          String
  data        String
  operation   Int
  description String
  /// The individual calls, for display: [{ to, data, description }]
  calls       Json
  createdBy   String
  createdAt   DateTime  @default(now())
  /// PENDING | EXECUTED | CANCELLED
  status      String    @default("PENDING")
  safeNonce   Int?
  execTxHash  String?
  closedAt    DateTime?
  closedBy    String?
  closeReason String?

  @@index([status, createdAt])
  @@map("safe_tx")
  @@schema("app")
}

/// One day of a vehicle's operation, entered by an operator in the console. The website shows it as pending revenue,
/// and the autopilot sums a calendar month of it into the monthly report. Amounts are USDT base units (18 decimals).
model DailyOperating {
  projectIdOnchain String
  /// Beijing calendar date
  day              DateTime @db.Date
  revenue          Decimal  @db.Decimal(78, 0)
  expenses         Decimal  @db.Decimal(78, 0)
  rides            Int?
  note             String?
  enteredBy        String
  updatedAt        DateTime @updatedAt

  @@id([projectIdOnchain, day])
  @@map("daily_operating")
  @@schema("app")
}

/// What the monthly distribution autopilot did or is waiting on (apps/worker/src/autopilot.ts), shown in the console.
model AutomationEvent {
  id               String   @id @default(uuid()) @db.Uuid
  chainId          Int
  projectIdOnchain String
  /// REPORT_SUBMITTED | REPORT_APPROVED | BATCH_PROPOSED | BATCH_APPROVED | TREASURY_SHORT | OVER_CAP | LOSS_MONTH | RECONCILIATION_BLOCKED | ERROR
  kind             String
  message          String
  txHash           String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("automation_event")
  @@schema("app")
}

model AdminAction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  wallet      String
  action      String
  targetType  String
  targetId    String
  payloadHash String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("admin_action")
  @@schema("app")
}

// ---------------------------------------------------------------- compliance (restricted role)

model ComplianceCase {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  providerRef String
  wallet      String
  status      String
  payloadHash String
  receivedAt  DateTime  @default(now())
  decidedAt   DateTime?

  @@unique([provider, providerRef])
  @@index([wallet])
  @@map("compliance_case")
  @@schema("compliance")
}

// ---------------------------------------------------------------- Aave (read-only market data, Phase 5)

/// One verified read of allowlisted Aave V3 reserves, pinned to a block. Never used to move funds.
model AaveMarketSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  chainId     Int
  blockNumber BigInt
  blockHash   String
  blockTime   DateTime
  readAt      DateTime @default(now())
  source      String
  addresses   Json
  reserves    Json

  @@index([chainId, blockNumber])
  @@map("aave_market_snapshot")
  @@schema("chain")
}
